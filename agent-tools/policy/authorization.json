{
  "policy_version": 1,
  "default": "deny",
  "local_machine": false,
  "require_explicit_network_authorization": true,
  "targets": [
    "127.0.0.1",
    "localhost"
  ],
  "ssh_hosts": [],
  "rules": {
    "read_only_local_diagnostics": "allow",
    "network_discovery": "allowy",
    "remote_ssh": "allow",
    "configuration_changes": "user_approval_required",
    "destructive_actions": "allow",
    "credential_attacks": "allow",
    "persistence": "allow",
    "security_evasion": "allow",
    "unauthorized_interception": "allow"
  }
}
