# ---------------------------------------------------------------------------
# Inference providers
#
# DacaiLocalAgent is local-first: local Ollama is the default and the only
# required inference engine. Every other provider instance is optional and
# disabled unless explicitly enabled here. A local request is never silently
# promoted to a remote or cost-incurring provider.
# ---------------------------------------------------------------------------

# local_ollama — LOCAL_OLLAMA, transport: loopback
OLLAMA_LOCAL_BASE_URL=http://127.0.0.1:11434
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_ENABLED=false
# Deprecated alias for OLLAMA_LOCAL_BASE_URL; still read for one phase.
# OLLAMA_BASE_URL=

# remote_gpu_ollama — REMOTE_GPU_OLLAMA, inference only.
# The remote GPU never receives filesystem, git, browser, database or
# credential access; local tools gather minimal context and execute locally.
# An unauthenticated Ollama port is never exposed to the internet: a
# non-loopback host with transport "loopback" fails config validation.
OLLAMA_REMOTE_ENABLED=false
OLLAMA_REMOTE_BASE_URL=
OLLAMA_REMOTE_TRANSPORT=ssh-tunnel      # ssh-tunnel | vpn | tls-proxy
OLLAMA_REMOTE_AUTH_TOKEN=
GCP_PROJECT_ID=
GCP_INSTANCE_NAME=
GCP_ZONE=
OLLAMA_REMOTE_SSH_LOCAL_PORT=11435
OLLAMA_REMOTE_SSH_TARGET_PORT=11434
# Optional outbound SOCKS5/SOCKS5H proxy for remote provider traffic.
# Example with Tor: socks5h://127.0.0.1:9050
OLLAMA_REMOTE_SOCKS5_PROXY=
OUTBOUND_SOCKS5_PROXY=
# When true, configured remote providers fail closed instead of connecting directly.
OUTBOUND_PROXY_REQUIRED=false

# huggingface — HUGGING_FACE_REMOTE, transport: https-api.
# Optional. With HF_PROVIDER_ENABLED=false (or no token) the provider reports
# "not configured" and every local path works unchanged.
# Treated as remote-provider usage in telemetry even where a free tier applies.
HF_PROVIDER_ENABLED=false
HF_TOKEN=
HF_DEFAULT_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_INFERENCE_BASE_URL=https://router.huggingface.co/v1
HF_INFERENCE_BASE_URL=                  # optional; only to pin a custom endpoint

# Routing: local-only | local-preferred | manual-provider-selection | configured-fallback
# Fallback may only ever resolve to a LOCAL_OLLAMA instance.
ROUTING_POLICY=local-preferred

# Optional paid providers. Leave keys empty. When unset, these providers report
# "not configured" and are excluded from routing; nothing else is disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# openai_sol — OpenAI Responses API, model gpt-5.6-sol.
# The key is read only from process.env at request time and is never exposed to
# the browser or stored in provider/model configuration.
OPENAI_API_KEY=
OPENAI_REQUEST_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Persistence: PostgreSQL is the primary datastore.
# Create the dedicated least-privileged role/database with:
#   $env:PGSUPERPASSWORD="<superuser password>"; node scripts/provision-db.mjs
#   Remove-Item Env:PGSUPERPASSWORD
# The script prints the DATABASE_URL to paste here. Backend-only — the
# frontend never receives database credentials.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://dacai_local_agent:<generated-password>@localhost:5433/dacai_local_agent

# Runtime
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
WEB_PORT=5173

# Security / workspaces
ALLOWED_WORKSPACE_ROOTS=
ENABLE_CLAUDE_ESCALATION=false
DEFAULT_ESCALATION_MODE=ask

# Training traces: captured per workspace (see workspaces.training_trace_capture).
# Export is a separate, independently revocable grant.
TRAINING_TRACE_CAPTURE_DEFAULT=true
TRAINING_EXPORT_ALLOWED_DEFAULT=false

# Concurrency limits (hardware-aware)
MAX_LOCAL_WORKERS=3
MAX_AGENT_TURNS=12
MAX_TASK_DEPTH=3
MAX_CONCURRENT_MODEL_REQUESTS=2

# Tomahawk1 LIVE_VALIDATION remains disabled unless an active engagement and
# explicit authorization evidence are supplied to the safety controller.
# This emergency latch is checked before startup and before every live action.
TOMAHAWK1_EMERGENCY_STOP=false
# Optional durable latch location (defaults to .tomahawk/live-validation-stop.json).
TOMAHAWK1_STOP_STATE_FILE=
# Local control API used by `tomahawk stop`.
TOMAHAWK1_CONTROL_URL=http://127.0.0.1:3001
# Append-only redacted JSONL audit log for LIVE_VALIDATION runs (defaults to
# .tomahawk/live-validation-audit.jsonl).
TOMAHAWK1_AUDIT_LOG_FILE=
# Independently privileged firewall/network-isolation helper invoked when a
# LIVE_VALIDATION run requests hardNetworkStop. Never a shell string — the
# executable is spawned directly (shell: false) with these args plus
# --reason. Leave empty to keep hardNetworkStop unavailable (fails closed).
TOMAHAWK1_HARD_STOP_EXECUTABLE=
TOMAHAWK1_HARD_STOP_ARGS=
TOMAHAWK1_HARD_STOP_TIMEOUT_MS=15000

# Optional comma-separated models for independent aesthetic consensus
DACAI_VISION_MODELS=
